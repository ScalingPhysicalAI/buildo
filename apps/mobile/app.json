{
  "expo": {
    "name": "Buildo Creators",
    "slug": "buildo-trainer",
    "scheme": "buildotrainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starforgerobotics.buildotrainer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 420,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Allow Buildo Creators to find and connect to your capture glasses over Bluetooth."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Buildo Creators to use your location to show prices in your local currency."
        }
      ]
    ],
    "android": {
      "package": "com.starforgerobotics.buildotrainer",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CHANGE_WIFI_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e4d0010-677b-4646-a209-25b344180baf"
      }
    },
    "owner": "sarthak-code360"
  }
}
